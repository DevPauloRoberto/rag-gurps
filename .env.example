# Configuração do Banco de Dados PostgreSQL (pgvector)
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gurps_rag
COLLECTION_NAME=gurps_regras

# Configuração dos Modelos no Ollama e Tokenizer HuggingFace
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDINGS_MODEL=bge-m3:latest
TOKENIZER_MODEL=BAAI/bge-m3
LLM_MODEL=qwen2.5:7b

# Configuração de Ingestão e Chunking (por Tokens)
DOCS_DIR=documentos
REPOS_DIR=documentos/repos
CHUNK_SIZE=500
CHUNK_OVERLAP_RATIO=0.10
